{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jj-ervin/open-ttd/schema/industry.schema.json",
  "title": "OpenTTD Economy Industry",
  "type": "object",
  "required": ["id", "name", "role", "module", "era", "hard_inputs", "outputs"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "name": {"type": "string", "minLength": 1},
    "role": {"enum": ["extraction", "processing", "manufacturing", "supply_production", "service", "logistics"]},
    "module": {"type": "string", "minLength": 1},
    "era": {"$ref": "#/$defs/era"},
    "geography": {"type": "array", "items": {"type": "string"}},
    "hard_inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "operational_supplies": {"type": "array", "items": {"$ref": "#/$defs/supply"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/output"}},
    "personnel": {"$ref": "#/$defs/personnel"},
    "predecessor": {"type": "string"},
    "successor": {"type": "string"},
    "scale": {"type": "string"},
    "storage": {"type": "string"},
    "notes": {"type": "string"}
  },
  "$defs": {
    "era": {"type": "object", "required": ["start", "end"], "additionalProperties": false, "properties": {"start": {"type": "integer"}, "end": {"type": "integer"}}},
    "input": {"type": "object", "required": ["cargo", "amount", "relationship"], "additionalProperties": false, "properties": {"cargo": {"type": "string"}, "amount": {"type": "number", "exclusiveMinimum": 0}, "relationship": {"enum": ["required", "proportional", "preferred", "alternative", "optional"]}, "group": {"type": "string"}}},
    "supply": {"type": "object", "required": ["cargo"], "additionalProperties": false, "properties": {"cargo": {"type": "string"}, "effect": {"enum": ["productivity", "capacity", "reliability", "efficiency"]}}},
    "output": {"type": "object", "required": ["cargo", "amount"], "additionalProperties": false, "properties": {"cargo": {"type": "string"}, "amount": {"type": "number", "exclusiveMinimum": 0}}},
    "personnel": {"type": "object", "additionalProperties": false, "properties": {"demand": {"type": "string"}, "returnable": {"type": "boolean"}}}
  }
}
