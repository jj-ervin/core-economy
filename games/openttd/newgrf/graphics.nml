        substitute: 0x0A;
        override: 0x0A;
    }
}

item(FEAT_INDUSTRYTILES, tile_coal_mine_4) {
    property {
        substitute: 0x0B;
        override: 0x0B;
    }
}

tilelayout layout_coal_mine {
    0, 0: tile_coal_mine_1;
    0, 1: tile_coal_mine_2;
    1, 0: tile_coal_mine_3;
    1, 1: tile_coal_mine_4;
}

