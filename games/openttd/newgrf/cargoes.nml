// Core Economy canonical cargo definitions.
//
// The Stage 2 cargo contract is the source of truth. Built-in OpenTTD labels
// are reused where their semantics match the canonical cargo exactly:
// GRAI, LVST, WOOD, COAL, IORE, OIL_, STEL, PASS, MAIL.
// All other canonical cargoes receive explicit Core Economy cargo definitions.

#define CARGO_DEFAULT_PROPERTIES(_label, _name, _unit, _abbr, _classes) \
item(FEAT_CARGOS, cargo_##_label, _label) { \
    property { \
        cargo_label: #_label; \
        type_name: string(_name); \
        unit_name: string(_unit); \
        type_abbreviation: string(_abbr); \
        weight: 1.0; \
        is_freight: 1; \
        cargo_classes: bitmask(_classes); \
        town_growth_effect: TOWNGROWTH_NONE; \
        town_growth_multiplier: 1.0; \
    } \
}

// Primary extraction and resource cargos.
item(FEAT_CARGOS, cargo_fish, 3) {
    property { cargo_label: "FISH"; type_name: string(STR_CARGO_NAME_FISH); unit_name: string(STR_CARGO_UNIT_FISH); type_abbreviation: string(STR_CARGO_ABBREV_FISH); weight: 1.0; is_freight: 1; cargo_classes: bitmask(CC_REFRIGERATED); town_growth_effect: TOWNGROWTH_NONE; }
}
