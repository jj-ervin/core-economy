// Core Economy canonical cargo adapter.
//
// Stage 2 cargoes.json is authoritative for the economic model. This file
// maps every canonical cargo to an OpenTTD cargo label. OpenTTD's original
// cargo slots 0-11 are never redefined here. Labels that exist in OpenTTD
// with matching semantics are reused through the canonical cargotable.
//
// Custom cargoes use slots 12+ and explicitly set number == item ID.

// Built-in OpenTTD cargo labels reused by Core Economy:
// GRAI, LVST, WOOD, COAL, IORE, OIL_, CORE, STEL, GOLD, FOOD, PASS, MAIL.
//
// Custom cargo slot allocation is deliberately independent of canonical
// translation-table order. The translation table is the stable label map;
// custom item IDs are local cargo slots and must remain >= 12.

item(FEAT_CARGOS, cargo_fish, 12) {
    property {
        number: 12;
        cargo_label: "FISH";
        type_name: string(STR_CARGO_NAME_FISH);
        unit_name: string(STR_CARGO_UNIT_FISH);
        type_abbreviation: string(STR_CARGO_ABBREV_FISH);
        weight: 1.0;
        is_freight: 1;
        cargo_classes: bitmask(CC_REFRIGERATED);
        town_growth_effect: TOWNGROWTH_NONE;
    }
}

